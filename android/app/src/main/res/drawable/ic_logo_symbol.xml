<?xml version="1.0" encoding="utf-8"?>
<!--
  부산 땅따먹기 로고 심볼
  - 조각난 부산 땅 + 깃발
  - 깃발이 꽂힌 중앙 조각이 가장 밝은 코럴(#E8635F = 100% 점령),
    바깥으로 갈수록 어두워짐 (지도 히트맵 점령률 스케일과 동일)
  - 조각 사이 간격은 배경색(#1C1B19) 스트로크
-->
<vector xmlns:android="http://schemas.android.com/apk/res/android"
    android:width="48dp"
    android:height="36dp"
    android:viewportWidth="400"
    android:viewportHeight="300">

    <!-- 좌상단 조각 (미점령) -->
    <path
        android:pathData="M105,150 L142,116 L176,114 L186,142 L150,170 L116,170 Z"
        android:fillColor="#5C3F38"
        android:strokeColor="#1C1B19"
        android:strokeWidth="5"
        android:strokeLineJoin="round" />

    <!-- 상단 중앙 조각 -->
    <path
        android:pathData="M186,142 L176,114 L216,104 L242,122 L236,146 Z"
        android:fillColor="#8F5346"
        android:strokeColor="#1C1B19"
        android:strokeWidth="5"
        android:strokeLineJoin="round" />

    <!-- 우상단 조각 (미점령) -->
    <path
        android:pathData="M242,122 L282,112 L316,132 L300,152 L250,152 Z"
        android:fillColor="#5C3F38"
        android:strokeColor="#1C1B19"
        android:strokeWidth="5"
        android:strokeLineJoin="round" />

    <!-- 좌하단 조각 -->
    <path
        android:pathData="M116,170 L150,170 L166,194 L150,222 L120,210 Z"
        android:fillColor="#8F5346"
        android:strokeColor="#1C1B19"
        android:strokeWidth="5"
        android:strokeLineJoin="round" />

    <!-- 중앙 조각 — 깃발이 꽂힌 곳 (완전 점령) -->
    <path
        android:pathData="M150,170 L186,142 L236,146 L231,187 L196,222 L166,194 Z"
        android:fillColor="#E8635F"
        android:strokeColor="#1C1B19"
        android:strokeWidth="5"
        android:strokeLineJoin="round" />

    <!-- 우하단 조각 -->
    <path
        android:pathData="M236,146 L250,152 L300,152 L295,182 L256,205 L231,187 Z"
        android:fillColor="#C75B52"
        android:strokeColor="#1C1B19"
        android:strokeWidth="5"
        android:strokeLineJoin="round" />

    <!-- 깃대 -->
    <path
        android:pathData="M200,158 L200,22"
        android:strokeColor="#EDEBE8"
        android:strokeWidth="8"
        android:strokeLineCap="round" />

    <!-- 깃발 -->
    <path
        android:pathData="M204,26 C246,12 262,44 306,28 C300,52 312,62 300,82 C258,96 244,66 204,80 Z"
        android:fillColor="#EDEBE8" />

</vector>
