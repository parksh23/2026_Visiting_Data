# ─────────────────────────────────────────────────────────
#  릴리스 서명 설정 템플릿
#
#  이 파일을 같은 폴더(android/)에 keystore.properties 라는 이름으로
#  복사한 뒤 실제 값으로 채우세요.
#  keystore.properties 와 *.jks 는 .gitignore 로 막혀 있어 커밋되지 않습니다.
#
#  ⚠️ 이 비밀번호와 .jks 파일을 잃어버리면 앱 업데이트가 영원히 불가능합니다.
#     비밀번호 관리자에 저장하고, .jks 는 별도 안전한 곳에 백업하세요.
# ─────────────────────────────────────────────────────────

# .jks 파일 경로 (android/ 폴더 기준 상대경로)
storeFile=busanquest-release.jks

# 키스토어 비밀번호 (keytool 이 처음 물어보는 것)
storePassword=여기에_키스토어_비밀번호

# 키 별칭 (-alias 로 지정한 값)
keyAlias=busanquest

# 키 비밀번호 (보통 키스토어 비밀번호와 동일하게 둡니다)
keyPassword=여기에_키_비밀번호
