# 이 파일을 같은 폴더에 keystore.properties 라는 이름으로 복사한 뒤 값을 채운다.
# keystore.properties 는 .gitignore 에 있으므로 커밋되지 않는다. 절대 커밋하지 말 것.
#
# ⚠️ 경로의 역슬래시(\) 주의
#    .properties 파일에서 \ 는 이스케이프 문자다. Windows 경로를 그대로 붙여넣으면 깨진다.
#    슬래시(/)를 쓰거나 역슬래시를 두 번(\\) 쓴다.
#
#    O   C:/Users/jwy93/keystores/busanquest-release.jks
#    O   C:\\Users\\jwy93\\keystores\\busanquest-release.jks
#    X   C:\Users\jwy93\keystores\busanquest-release.jks
#
# storeFile 은 android/ 폴더 기준의 상대 경로도 되지만,
# 키스토어는 저장소 바깥에 두는 것을 권장하므로 절대 경로가 보통이다.

storeFile=C:/Users/사용자명/keystores/busanquest-release.jks
storePassword=키_저장소_비밀번호
keyAlias=busanquest
keyPassword=키_비밀번호
