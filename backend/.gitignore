# ──────────────────────────────────────────────────────────
# 파이썬 및 FastAPI 백엔드 프로젝트 .gitignore 설정
# ──────────────────────────────────────────────────────────

# 1. 가상환경
venv/
.venv/
env/
ENV/

# 2. 운영체제 및 IDE 설정 파일
.vscode/
.idea/
*.suo
*.ntvs*
*.njsproj
*.sln
*.swp
.DS_Store
Thumbs.db

# 3. 파이썬 실행 중 생성되는 컴파일 캐시 파일
**/__pycache__/
*.pyc
*.pyo
*.pyd
.pytest_cache/
.mypy_cache/

# 4. 보안 및 환경 변수 파일 (DB 비밀번호, API 키 등이 들어있으므로 절대 금지 🚨)
.env
app/.env
.env.local
.env.*.local
wallet/
**/wallet/
app/wallet/
# Firebase 서비스 계정 키 파일 및 보안 폴더 차단 🚨
secrets/
app/secrets/
**/secrets/
firebase*.json
*service-account*.json

# 5. 데이터베이스 및 로그 파일
*.db
*.sqlite3
*.log
logs/
data/
!app/data/
!app/data/transport/
!app/data/transport/busan_bus_stops.csv
!app/data/transport/busan_rail_stations.csv