# 운영 환경: Oracle 연결 정보
ORACLE_USER=ADMIN
ORACLE_PASSWORD=replace-me
ORACLE_DSN=replace-me
ORACLE_WALLET_PATH=
ORACLE_WALLET_PASSWORD=

# 또는 로컬 개발/테스트용 SQLite
# DATABASE_URL=sqlite:///./busan_quest.db

JWT_SECRET_KEY=replace-with-a-long-random-secret
JWT_EXPIRE_MINUTES=10080
MAX_UPLOAD_BYTES=5242880
CORS_ALLOWED_ORIGINS=
GEMINI_API_KEY=replace-with-gemini-api-key
TOURISM_DATA_SERVICE_KEY=replace-with-data-go-kr-service-key
TOURISM_ADMIN_KEY=replace-with-long-random-admin-key

# 비밀번호 복구 메일. Gmail 사용 시 SMTP_PASSWORD에는 앱 비밀번호를 입력합니다.
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USERNAME=replace-with-email
SMTP_PASSWORD=replace-with-app-password
SMTP_FROM=replace-with-email
