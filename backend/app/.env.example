# 운영 환경: Oracle 연결 정보
ORACLE_USER=ADMIN
ORACLE_PASSWORD=replace-me
ORACLE_DSN=replace-me
ORACLE_WALLET_PATH=
ORACLE_WALLET_PASSWORD=

# 또는 로컬 개발/테스트용 SQLite
# DATABASE_URL=sqlite:///./busan_quest.db

JWT_SECRET_KEY=replace-with-a-long-random-secret
JWT_EXPIRE_MINUTES=10080
MAX_UPLOAD_BYTES=5242880
TOURISM_DATA_SERVICE_KEY=replace-with-data-go-kr-service-key
TOURISM_ADMIN_KEY=replace-with-long-random-admin-key

# Firebase Admin SDK 서비스 계정 JSON 전체 문자열 또는 JSON 파일 경로
FIREBASE_CREDENTIALS_JSON=
# GOOGLE_APPLICATION_CREDENTIALS=/absolute/path/to/firebase-service-account.json
INTERNAL_JOB_KEY=replace-with-a-long-random-job-key

# Required for PHOTO/CURRENT_LOCATION verification. Missing settings deny verification.
# Link this Cloud project to kr.co.busanquest in Play Console and enable Play Integrity API.
PLAY_INTEGRITY_CLOUD_PROJECT_NUMBER=
# URL-safe base64 SHA-256 of the PLAY APP SIGNING certificate (comma-separated for rotation).
PLAY_INTEGRITY_CERTIFICATE_DIGESTS=
PLAY_INTEGRITY_MIN_VERSION_CODE=6
# ADC service account authorized for the linked project; never bundle credentials in the APK.
# GOOGLE_APPLICATION_CREDENTIALS=/run/secrets/play-integrity-service-account.json
